// Configuração do Worker advocacia.legal.
// Atenção: bindings (D1, R2, vars) NÃO são herdados entre ambientes no Wrangler;
// por isso ficam declarados dentro de cada ambiente ("dev" e "prod").
// Use sempre --env dev ou --env prod. Nenhum segredo fica neste arquivo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // A API roda primeiro no Worker; o resto é servido como arquivo estático (SPA).
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "dev": {
      "name": "advocacia-legal-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "dev.app.advocacia.legal", "custom_domain": true }],
      "vars": {
        "AMBIENTE": "dev",
        "URL_APP": "https://dev.app.advocacia.legal",
        // E-mail diário de prazos (Resend): chave geral LIGADA no dev (decisão de 2026-10-28; prod segue desligado) (docs/EMAIL.md).
        // Mesmo ligada, só recebe quem ativou em "Minha conta".
        "EMAIL_ALERTAS_ATIVO": "true",
        // Remetente confirmado pelo dono em 2026-10-28 (precisa ser de um domínio verificado no Resend).
        "EMAIL_REMETENTE": "alertas@advocacia.legal",
        // Movimentações pelo DataJud (CNJ): LIGADO só em dev. Também precisa do segredo DATAJUD_CHAVE (workflow configurar-datajud). docs/DATAJUD.md.
        "DATAJUD_ATIVO": "true"
      },
      // Cron Trigger usa UTC. 10:00 UTC = 07:00 em America/Sao_Paulo (UTC-3 o ano todo: o Brasil não tem horário de verão desde 2019).
      "triggers": { "crons": ["0 10 * * *"] },
      // Workers AI (resumo das intimações). Franquia e preço: docs/IA.md.
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "advocacia-legal-dev",
          "database_id": "dc1609a4-a249-4548-a1ea-f934cb54eb48",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "ARQUIVOS", "bucket_name": "advocacia-legal-dev" }]
    },
    "prod": {
      "name": "advocacia-legal",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.advocacia.legal", "custom_domain": true }],
      "vars": {
        "AMBIENTE": "prod",
        "URL_APP": "https://app.advocacia.legal",
        // E-mail diário de prazos (Resend): chave geral DESLIGADA até o Resend estar configurado (docs/EMAIL.md).
        // Mesmo ligada, só recebe quem ativou em "Minha conta".
        "EMAIL_ALERTAS_ATIVO": "false",
        // Remetente SUGERIDO, a confirmar com o dono (precisa ser de um domínio verificado no Resend).
        "EMAIL_REMETENTE": "alertas@advocacia.legal",
        // Movimentações pelo DataJud (CNJ): DESLIGADO em prod. Os termos de uso do CNJ (v1.2, cláusulas 3.3 e 3.8) proíbem uso comercial. docs/DATAJUD.md.
        "DATAJUD_ATIVO": "false"
      },
      // Cron Trigger usa UTC. 10:00 UTC = 07:00 em America/Sao_Paulo (UTC-3 o ano todo: o Brasil não tem horário de verão desde 2019).
      "triggers": { "crons": ["0 10 * * *"] },
      // Workers AI (resumo das intimações). Franquia e preço: docs/IA.md.
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "advocacia-legal-prod",
          "database_id": "2f2cac5f-5885-455e-b31d-61094f2c707e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "ARQUIVOS", "bucket_name": "advocacia-legal-prod" }]
    }
  }
}
